{{!< default}}{{#post}}<h1>{{title}}</h1>{{#match post_kind "event"}}<p class="status">{{event_status}}</p>{{#if event_all_day}}<p>All day · {{date event_start_at timezone=event_timezone format="dddd D MMMM YYYY"}}{{#match (date event_start_at timezone=event_timezone format="YYYY-MM-DD") "!=" (date event_end_at timezone=event_timezone exclusive_end=true format="YYYY-MM-DD")}} — {{date event_end_at timezone=event_timezone exclusive_end=true format="dddd D MMMM YYYY"}}{{/match}}</p><p>{{event_timezone}} · {{event_location}}</p>{{else}}<dl><dt>Starts</dt><dd>{{date event_start_at timezone=event_timezone format="dddd D MMMM YYYY, h:mm a z"}}</dd><dt>Finishes</dt><dd>{{date event_end_at timezone=event_timezone format="dddd D MMMM YYYY, h:mm a z"}}</dd><dt>Timezone</dt><dd>{{event_timezone}}</dd><dt>Where</dt><dd>{{event_location}}</dd></dl>{{/if}}{{#if event_booking_url}}<a class="button" href="{{event_booking_url}}">Booking details</a>{{/if}}{{/match}}<article>{{content}}</article><p class="note">Announcement published {{date published_at format="D MMMM YYYY"}}.</p>{{/post}}